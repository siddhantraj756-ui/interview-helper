# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional preferred LLM provider. Keys entered in the app are stored in the OS keychain.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol

# Optional Gemini fallback credentials. Paid/free labels describe the projects you select;
# Gemini keys do not identify a billing tier.
GEMINI_PAID_API_KEY=
GEMINI_FREE_API_KEY=

# Speech Recognition Configuration
# Choose one provider: azure or whisper
SPEECH_PROVIDER=whisper

# Optional: Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Local OpenAI Whisper Configuration
# Requires a local Whisper CLI installation, for example:
#   pip install openai-whisper
#   brew install ffmpeg sox
# Use `whisper`, `python3 -m whisper`, or on Windows `.venv-whisper/Scripts/whisper.exe`
WHISPER_COMMAND=whisper
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). Set an ABSOLUTE path to override; a relative
# path is ignored because it cannot be resolved reliably in packaged builds.
# WHISPER_MODEL_DIR=
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_SEGMENT_MS=4000
WHISPER_DEVICE=auto
WHISPER_PYTHON=
WHISPER_CAPTURE_MODE=vad
WHISPER_RESPONSE_TARGET=both
WHISPER_MANUAL_MAX_MS=90000
WHISPER_GPU_IDLE_MS=60000

# Optional interview context (avoid private information you do not want sent to an LLM).
CANDIDATE_RESUME=
JOB_DESCRIPTION=

# ── Linux Remote Control Mode ──────────────────────────────────────────────────
# On Linux, setContentProtection is a no-op (content is always visible in screen
# shares). OpenCluely therefore runs fully headless on Linux and starts a local
# HTTP + WebSocket server so any device on the same network can control the app
# from a browser.
#
# The server prints the host IP(s) and PIN to the terminal on startup.
# Open http://<host-ip>:REMOTE_CONTROL_PORT on another device and enter the PIN.

# Port for the remote control web server (default: 3099)
REMOTE_CONTROL_PORT=3099

# Optional: set a fixed PIN instead of generating a random one each launch.
# If left blank, a new 6-digit PIN is generated on every start.
REMOTE_CONTROL_PIN=
